{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS - Advanced Voice Assistant Desktop App",
  "main": "main.js",
  "homepage": "./",
  "author": "JARVIS Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder -l"
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest",
    "electron-squirrel-startup": "^latest"
  },
  "dependencies": {},
  "build": {
    "appId": "com.jarvis.app",
    "productName": "JARVIS",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "script.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
